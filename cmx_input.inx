<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Corel Presentation Exchange Input (bundled cdr2svg)</name>
  <id>org.inkscape.input.cdr2svg.cmx</id>
  <input>
    <extension>.cmx</extension>
    <mimetype>image/x-cmx</mimetype>
    <filetypename>Corel Presentation Exchange (bundled cdr2svg) (*.cmx)</filetypename>
    <filetypetooltip>Import Corel CMX files using the bundled patched libcdr converter</filetypetooltip>
  </input>
  <script>
    <command location="inx" interpreter="python">cdr_input.py</command>
  </script>
</inkscape-extension>
